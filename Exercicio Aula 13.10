import numpy as np

###Metodo de Newton

def F(x_1, x_2):
    f1 = x_1**2 + x_2**2 - 4
    f2 = x_1**2 - x_2 - 1
    return np.array([f1,f2])

def J(x_1,x_2):
    a11 = 2*x_1
    a12 = 2*x_2
    a21 = 2*x_1
    a22 = -1
    return np.array([[a11, a12],[a21, a22]])

epsilson_1 = 10**(-6)
epsilson_2 = 10**(-6)
x0 = np.array([1.0, 1.0])
it_max = 10000

def newton(x0, e1, e2, it):

    print("\n Começando o método de Newton..." )
    x = x0
    for i in range(1, it):
        F0 = F(x0[0], x0[1])
        J0 = F(x0[0], x0[1])

        if np.linalg.norm(F0, ord=np.inf) < e1:
            print(f'iteração: {i} -- x: {x0} -- F_norma: {F0}')
            return 

        if np.linalg.det(J0)==0:
            print(f'iteração: {i} -- x: {x0} -- F_norma: {np.linalg.norm(F0, ord=np.inf)}')
            return
        s = np.linalg.solve(J0, -F0)
        x0 = x0 + s
        if np.linalg.norm(s, ord=np.inf) < e2:
             print(f'iteração: {i} -- x: {x0} -- F_norma: {np.linalg.norm(F0, ord=np.inf)}')
             return

